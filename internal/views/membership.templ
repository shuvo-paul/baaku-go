package views

import (
	"strconv"
	"strings"
	"time"
)

// ---- shared membership view helpers ----

// formatMoney renders money as "<Currency> 1,500.00" (reference
// Members::formatMoney). The amount is the canonical "1500.00" string.
func formatMoney(currency, amount string) string {
	// Split an integral and fractional part so we can add thousands commas.
	intPart := amount
	frac := ""
	if i := strings.IndexByte(amount, '.'); i >= 0 {
		intPart, frac = amount[:i], amount[i:]
	}
	var b strings.Builder
	for i, c := range intPart {
		if i > 0 && (len(intPart)-i)%3 == 0 {
			b.WriteByte(',')
		}
		b.WriteRune(c)
	}
	return currency + " " + b.String() + frac
}


// membershipStatusBadge returns the Tailwind pill classes for a membership
// status (reference status pill colours).
func membershipStatusBadge(status string) string {
	switch status {
	case "active":
		return "bg-emerald-100 text-emerald-800"
	case "expired":
		return "bg-yellow-100 text-yellow-800"
	case "cancelled":
		return "bg-gray-100 text-gray-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

// membershipStatusLabel is the display label for a membership status.
func membershipStatusLabel(status string) string {
	switch status {
	case "active":
		return "Active"
	case "expired":
		return "Expired"
	case "cancelled":
		return "Cancelled"
	default:
		return status
	}
}

// paymentStatusBadge returns the Tailwind pill classes for a payment status.
func paymentStatusBadge(status string) string {
	switch status {
	case "approved":
		return "bg-emerald-100 text-emerald-800"
	case "pending":
		return "bg-yellow-100 text-yellow-800"
	case "rejected":
		return "bg-red-100 text-red-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

// paymentStatusLabel is the display label for a payment status.
func paymentStatusLabel(status string) string {
	switch status {
	case "approved":
		return "Approved"
	case "pending":
		return "Pending"
	case "rejected":
		return "Rejected"
	default:
		return status
	}
}

// featureLabel maps a gated-feature key to its display label (reference
// membership.feature_{key}).
func featureLabel(key string) string {
	switch key {
	case "members":
		return "Member Directory"
	case "posts":
		return "Posts"
	default:
		return key
	}
}

// dateOr renders a *time.Time as "d M Y", or the fallback when nil.
func dateOr(t *time.Time, fallback string) string {
	if t == nil {
		return fallback
	}
	return t.Format("02 Jan 2006")
}

// dateValue renders a *time.Time as a yyyy-mm-dd date-input value ("" when
// nil).
func dateValue(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("2006-01-02")
}

// methodLabel maps a payment-method type to its human label.
func methodLabel(t string) string {
	switch t {
	case "bkash":
		return "bKash"
	case "nagad":
		return "Nagad"
	case "bank_transfer":
		return "Bank Transfer"
	default:
		return t
	}
}

// ---- member-facing membership views ----

// MyMembershipData is the member's membership page (reference
// membership/show.blade.php).
type MyMembershipData struct {
	Sidebar       SidebarData
	HasActive     bool
	PlanName      string
	IsLifetime    bool
	StartsAt      *time.Time
	EndsAt        *time.Time
	Features      []string
	PendingPayID  int64 // non-zero → a payment awaits review
	Payments      []MyPaymentRow
	Currency      string
	Status        string // flash: membership-updated / membership-cancelled
	Err           string // flash: feature-locked / membership-not-active
	CSRF          string
}

// MyPaymentRow is one payment row on the member's membership page.
type MyPaymentRow struct {
	ID       int64
	PlanName string
	Amount   string
	Method   string
	PaidAt   time.Time
	Status   string
}

templ MyMembershipPage(d MyMembershipData) {
	@DashboardLayout(d.Sidebar) {
		<div class="space-y-8">
			if d.Err == "feature-locked" {
				@ErrText("This area is a membership feature. Activate or renew a plan that grants it.")
			} else if d.Err == "membership-not-active" {
				@ErrText("That membership is not active.")
			}
			if d.Status == "membership-updated" {
				@StatusText("Membership updated.")
			} else if d.Status == "membership-cancelled" {
				@StatusText("Membership cancelled.")
			}
			if d.PendingPayID != 0 {
				<a href={ templ.SafeURL("/dashboard/membership/payments/" + strconv.FormatInt(d.PendingPayID, 10)) } class="block rounded-lg border border-amber-800/25 bg-amber-800/5 px-4 py-3 text-sm text-amber-800">
					You have a payment awaiting review. <span class="font-semibold underline">Payment →</span>
				</a>
			}
			<section class="card p-6 lg:p-8">
				<p class="label-caps text-gold">Current membership</p>
				if d.HasActive {
					<h1 class="mt-2 font-serif text-3xl font-semibold text-navy">{ d.PlanName }</h1>
					<div class="mt-3 flex flex-wrap items-center gap-2">
						<span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">Active</span>
						if d.IsLifetime {
							<span class="rounded bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800">Lifetime membership</span>
						}
					</div>
					<dl class="mt-6 space-y-3 border-t border-outline-variant/60 pt-5 text-sm">
						<div class="flex items-start justify-between gap-4">
							<dt class="shrink-0 text-on-surface-variant">Starts</dt>
							<dd class="text-right text-navy">{ dateOr(d.StartsAt, "—") }</dd>
						</div>
						<div class="flex items-start justify-between gap-4">
							<dt class="shrink-0 text-on-surface-variant">Ends</dt>
							<dd class="text-right text-navy">{ dateOr(d.EndsAt, "Never") }</dd>
						</div>
					</dl>
					if len(d.Features) > 0 {
						<div class="mt-6 border-t border-outline-variant/60 pt-5">
							<p class="label-caps text-gold">Features</p>
							<ul class="mt-3 space-y-1.5 text-sm text-on-surface-variant">
								for _, f := range d.Features {
									<li class="flex items-center gap-2">
										<span class="text-gold">✓</span>
										<span>{ featureLabel(f) }</span>
									</li>
								}
							</ul>
						</div>
					}
					<div class="mt-6 flex flex-wrap gap-3">
						<a href="/dashboard/membership/plans" class="btn-primary">Renew / Upgrade</a>
					</div>
				} else {
					<h1 class="mt-2 font-serif text-3xl font-semibold text-navy">You do not have an active membership yet.</h1>
					<p class="mt-3 max-w-2xl leading-7 text-on-surface-variant">View plans and submit a payment to activate a membership.</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href="/dashboard/membership/plans" class="btn-primary">View plans</a>
						<a href="/dashboard/membership/payments/create" class="btn-secondary">Submit Payment</a>
					</div>
				}
			</section>
			<section class="card p-6 lg:p-8">
				<p class="label-caps text-gold">Membership History</p>
				if len(d.Payments) == 0 {
					<p class="mt-4 text-sm text-on-surface-variant">No payments yet.</p>
				} else {
					<table class="mt-4 w-full text-sm">
						<thead class="border-b border-outline-variant/60 text-left label-caps text-on-surface-variant">
							<tr>
								<th class="py-2 px-3">Paid on</th>
								<th class="py-2 px-3">Plan</th>
								<th class="py-2 px-3">Amount</th>
								<th class="py-2 px-3">Method</th>
								<th class="py-2 px-3">Status</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range d.Payments {
								<tr class="border-b border-outline-variant/40 last:border-0">
									<td class="py-2 px-3">{ p.PaidAt.Format("02 Jan 2006") }</td>
									<td class="py-2 px-3 text-navy">{ p.PlanName }</td>
									<td class="py-2 px-3">{ formatMoney(d.Currency, p.Amount) }</td>
									<td class="py-2 px-3 text-on-surface-variant">{ methodLabel(p.Method) }</td>
									<td class="py-2 px-3">
										<span class={ "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium", paymentStatusBadge(p.Status) }>{ paymentStatusLabel(p.Status) }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		</div>
	}
}

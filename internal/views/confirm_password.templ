package views

// ConfirmPasswordPage mirrors reference auth/confirm-password.blade.php
// (Fortify password.confirm).
templ ConfirmPasswordPage(appName, csrfToken string) {
	@Layout(appName) {
		@Card("Confirm password") {
			<p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
				This is a secure area of the application. Please confirm your password before continuing.
			</p>
			<form method="POST" action="/user/confirm-password" class="mt-6 space-y-4">
				@CSRFToken(csrfToken)
				@PasswordInput("Password", "password", templ.Attributes{"autofocus": true})
				@SubmitButton("Confirm")
			</form>
		}
	}
}

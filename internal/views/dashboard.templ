package views

// DashboardPage is the post-login landing (reference resources/views/
// dashboard.blade.php rendered inside layouts/dashboard). It shows the hero
// greeting + state badge, the quick-links grid (only routes that exist in the
// Go port), and the "Manage Your Profile" heritage card. Suspended accounts
// keep dashboard access but lose the quick links and the profile CTA.

type DashboardPageData struct {
	Sidebar SidebarData
	Name    string
	State   string
	Status  string
}

// stateBadge returns the Tailwind classes for a member-state pill, mirroring
// the reference users/partials/state-badge.blade.php colour map.
func stateBadge(state string) string {
	switch state {
	case "unverified":
		return "bg-orange-100 text-orange-700"
	case "pending":
		return "bg-yellow-100 text-yellow-800"
	case "active":
		return "bg-green-100 text-green-800"
	case "suspended":
		return "bg-red-100 text-red-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

// stateLabel is the display label for a member state.
func stateLabel(state string) string {
	switch state {
	case "unverified":
		return "Unverified"
	case "pending":
		return "Pending"
	case "active":
		return "Active"
	case "suspended":
		return "Suspended"
	case "rejected":
		return "Rejected"
	default:
		return state
	}
}

templ DashboardPage(d DashboardPageData) {
	@DashboardLayout(d.Sidebar) {
		<div class="space-y-12">
			if d.Status != "" {
				<div class="rounded-lg border border-emerald-800/25 bg-emerald-800/5 px-4 py-3 text-sm text-emerald-800">
					{ d.Status }
				</div>
			}
			if d.State == "suspended" {
				<div class="rounded-lg border border-error/25 bg-error/5 px-4 py-3 text-sm text-error">
					Your account has been suspended.
				</div>
			}
			<!-- Hero -->
			<section class="flex flex-wrap items-end justify-between gap-6">
				<div class="max-w-2xl">
					<p class="label-caps text-gold">Alumni Network</p>
					<h1 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-navy">
						{ "Welcome back, " + d.Name }
					</h1>
					<p class="mt-4 text-lg leading-8 text-on-surface-variant">
						Your alumni network brings mentorship, careers, and community together — all in one place.
					</p>
				</div>
				<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", stateBadge(d.State) }>
					{ stateLabel(d.State) }
				</span>
			</section>
			<!-- Quick links: the reference grid pulls Roles/Members/Careers/Posts/
			     Committee/Membership, each gated by permission or feature flag. Those
			     routes land in later waves; only the profile CTA below exists today. -->
			if d.State != "suspended" {
				<!-- Heritage accent: high-prestige content -->
				<section class="card border-l-4 border-gold p-8 sm:p-10">
					<p class="label-caps text-gold">Heritage</p>
					<h2 class="mt-2 font-serif text-2xl font-semibold text-navy">Manage Your Profile</h2>
					<p class="mt-3 max-w-2xl leading-7 text-on-surface-variant">
						Keep your education and career history current so classmates, mentors, and administrators can find you.
					</p>
					<a href="/dashboard/profile" class="btn-primary mt-6">View Profile</a>
				</section>
			}
		</div>
	}
}

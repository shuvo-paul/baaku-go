package views

// ResetPasswordPage mirrors reference auth/reset-password.blade.php
// (Fortify password.reset / password.update).
templ ResetPasswordPage(appName, csrfToken, token, email string) {
	@Layout(appName) {
		@Card("Reset password") {
			<form method="POST" action="/reset-password" class="mt-6 space-y-4">
				@CSRFToken(csrfToken)
				<input type="hidden" name="token" value={ token }/>
				@TextInput("Email", "email", "email", templ.Attributes{"autofocus": true, "value": email})
				@PasswordInput("Password", "password", nil)
				@PasswordInput("Confirm password", "password_confirmation", nil)
				@SubmitButton("Reset password")
			</form>
		}
	}
}

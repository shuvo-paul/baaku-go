package views

import (
	"strconv"
)

// ---- admin: membership plans CRUD ----

// AdminPlansData is the admin plans list (reference plans/index.blade.php).
type AdminPlansData struct {
	Sidebar SidebarData
	Rows    []AdminPlanRow
	Currency string
	Flash   string // plan-created / plan-updated / plan-deleted
	Err     string // plan-in-use
	CSRF    string
}

// AdminPlanRow is one plan in the admin list.
type AdminPlanRow struct {
	ID         int64
	Name       string
	TermLabel  string
	Price      string
	IsActive   bool
	SortOrder  int32
}

// AdminPlanForm is the shared create/edit plan form (reference
// plans/create.blade.php + plans/edit.blade.php).
type AdminPlanForm struct {
	Sidebar      SidebarData
	Title        string // "New Plan" / "Edit Plan"
	ID           int64  // 0 = create
	Name         string
	Description  string
	Price        string
	TermType     string // days / months / lifetime
	TermDays     string
	TermMonths   string
	IsLifetime   bool
	Features     []string // gateable feature keys
	Selected     map[string]bool
	IsActive     bool
	FlashMessage string
	Errors       map[string]string
	CSRF         string
}

// planFormAction is the form target: POST /dashboard/plans (create) or
// /dashboard/plans/{id} with a spoofed PUT (edit).
func planFormAction(id int64) string {
	if id == 0 {
		return "/dashboard/plans"
	}
	return "/dashboard/plans/" + strconv.FormatInt(id, 10)
}

templ AdminPlansPage(d AdminPlansData) {
	@DashboardLayout(d.Sidebar) {
		<div class="space-y-6">
			<section class="flex flex-wrap items-center justify-between gap-4">
				<h1 class="font-serif text-3xl font-semibold text-navy">Membership Plans</h1>
				<a href="/dashboard/plans/create" class="btn-primary">New Plan</a>
			</section>
			if d.Flash == "plan-created" {
				@StatusText("Plan created.")
			} else if d.Flash == "plan-updated" {
				@StatusText("Plan updated.")
			} else if d.Flash == "plan-deleted" {
				@StatusText("Plan deleted.")
			}
			if d.Err == "plan-in-use" {
				@ErrText("Cannot delete a plan that has memberships or payments. Deactivate it instead.")
			}
			<section class="card overflow-hidden">
				if len(d.Rows) == 0 {
					<p class="px-4 py-10 text-center text-on-surface-variant">No membership plans yet.</p>
				} else {
					<p class="px-4 pt-4 text-sm text-on-surface-variant">Use the arrows to reorder plans.</p>
					<table class="w-full text-sm" id="reorder-table" data-reorder-url="/dashboard/plans/reorder">
						<thead class="border-b border-outline-variant/60 text-left label-caps text-on-surface-variant">
							<tr>
								<th class="px-2 py-3 w-16">Order</th>
								<th class="px-4 py-3">Plan</th>
								<th class="px-4 py-3">Term</th>
								<th class="px-4 py-3">Price</th>
								<th class="px-4 py-3">Status</th>
								<th class="px-4 py-3 text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range d.Rows {
								<tr class="border-b border-outline-variant/40 last:border-0" data-id={ strconv.FormatInt(row.ID, 10) }>
									<td class="px-2 py-3">
										<button type="button" class="reorder-up rounded px-1 text-on-surface-variant hover:text-navy" aria-label="Move up">↑</button>
										<button type="button" class="reorder-down rounded px-1 text-on-surface-variant hover:text-navy" aria-label="Move down">↓</button>
									</td>
									<td class="px-4 py-3 font-semibold text-navy">{ row.Name }</td>
									<td class="px-4 py-3 text-on-surface-variant">{ row.TermLabel }</td>
									<td class="px-4 py-3">{ formatMoney(d.Currency, row.Price) }</td>
									<td class="px-4 py-3">
										if row.IsActive {
											<span class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">Active</span>
										} else {
											<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Inactive</span>
										}
									</td>
									<td class="px-4 py-3 text-right">
										<a href={ templ.SafeURL("/dashboard/plans/" + strconv.FormatInt(row.ID, 10) + "/edit") } class="mr-3 font-medium text-navy underline decoration-gold/50 underline-offset-2 hover:text-gold">Edit</a>
										<form method="POST" action={ templ.SafeURL("/dashboard/plans/" + strconv.FormatInt(row.ID, 10)) } class="ml-2 inline" onsubmit="return confirm('Delete this plan?')">
											<input type="hidden" name="_method" value="DELETE"/>
											@CSRFToken(d.CSRF)
											<button type="submit" class="font-medium text-red-600 hover:underline">Delete</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		</div>
		<script defer src="/static/membership.js"></script>
	}
}

templ AdminPlanFormPage(d AdminPlanForm) {
	@DashboardLayout(d.Sidebar) {
		<div class="max-w-2xl space-y-8">
			<section>
				<p class="label-caps text-gold">Membership Plans</p>
				<h1 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-navy">{ d.Title }</h1>
			</section>
			if d.FlashMessage != "" {
				@ErrText(d.FlashMessage)
			}
			<form method="POST" action={ templ.SafeURL(planFormAction(d.ID)) } class="card space-y-6">
				@CSRFToken(d.CSRF)
				if d.ID != 0 {
					<input type="hidden" name="_method" value="PUT"/>
				}
				@TextInput("Plan name", "name", "text", templ.Attributes{"value": d.Name})
				@ErrText(d.Errors["name"])
				@OptionalTextarea("Description", "description", d.Description)
				@TextInput("Price", "price", "text", templ.Attributes{"value": d.Price, "placeholder": "0.00"})
				@ErrText(d.Errors["price"])
				<fieldset class="space-y-3">
					<legend class="label-caps text-on-surface-variant">Term</legend>
					<div class="flex flex-wrap gap-4">
						<label class="flex items-center gap-2 text-sm"><input type="radio" name="term_type" value="days" checked?={ d.TermType == "days" } class="text-navy focus:ring-gold/50"/> Days</label>
						<label class="flex items-center gap-2 text-sm"><input type="radio" name="term_type" value="months" checked?={ d.TermType == "months" } class="text-navy focus:ring-gold/50"/> Months</label>
						<label class="flex items-center gap-2 text-sm"><input type="radio" name="term_type" value="lifetime" checked?={ d.TermType == "lifetime" } class="text-navy focus:ring-gold/50"/> Lifetime</label>
					</div>
					<div id="term-days" class="mt-3">
						@OptionalInput("Duration (days)", "term_days", "number", templ.Attributes{"value": d.TermDays, "min": "1"})
					</div>
					<div id="term-months" class="mt-3">
						@OptionalInput("Duration (months)", "term_months", "number", templ.Attributes{"value": d.TermMonths, "min": "1"})
					</div>
					<p class="text-sm text-on-surface-variant" id="term-lifetime-note">No end date — access never expires.</p>
					@ErrText(d.Errors["term_days"])
				</fieldset>
				<fieldset class="space-y-3">
					<legend class="label-caps text-on-surface-variant">Access this plan unlocks</legend>
					for _, f := range d.Features {
						@Checkbox(featureLabel(f), "feature_"+f, "1", d.Selected[f], nil)
					}
					<p class="text-xs text-on-surface-variant">Tick the dashboard areas members reach only with an active plan that grants them.</p>
				</fieldset>
				@Checkbox("Active", "is_active", "1", d.IsActive, nil)
				<div class="flex items-center gap-4">
					@SubmitButton(d.Title)
					<a href="/dashboard/plans" class="text-sm text-on-surface-variant hover:text-navy">Cancel</a>
				</div>
			</form>
		</div>
		<script defer src="/static/membership.js"></script>
	}
}

package views

// ForgotPasswordPage mirrors reference auth/forgot-password.blade.php
// (Fortify password.request / password.email). status is the session('status')
// flash from a successful link request (passwords.sent).
templ ForgotPasswordPage(appName, csrfToken, status, errMsg string) {
	@Layout(appName) {
		@Card("Forgot password") {
			<p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
				Forgot your password? No problem. Just let us know your email address and we will email you a password reset link.
			</p>
			@StatusText(status)
			@ErrText(errMsg)
			<form method="POST" action="/forgot-password" class="mt-6 space-y-4">
				@CSRFToken(csrfToken)
				@TextInput("Email", "email", "email", templ.Attributes{"autofocus": true})
				@SubmitButton("Email password reset link")
			</form>
			<div class="mt-4 text-center">
				<a href="/login" class="text-sm text-indigo-600 hover:text-indigo-500">Back to login</a>
			</div>
		}
	}
}
